# Окружение изолированного E2E-стека (docker-compose.e2e.yml). Все значения тестовые и
# несекретные: токен бота НЕ настоящий, Telegram подменён сервером из e2e/support/telegramMock.ts.
APP_ENV=local
BOT_TOKEN=100000:E2E_TEST_TOKEN_NOT_REAL
BOT_MODE=polling
BOT_USERNAME=e2e_bot
TELEGRAM_API_BASE=http://host.docker.internal:18081
# Владельца и ученика создаёт scripts/e2e_seed.py, поэтому OWNER_TELEGRAM_ID не задан.
PUBLIC_BASE_URL=http://127.0.0.1:18080
SESSION_SECRET=e2e-test-session-secret-not-for-production-0123456789
SESSION_COOKIE_SECURE=false
WEBHOOK_SECRET=e2e-test-webhook-secret-not-real
S3_BUCKET=lms-files
S3_ACCESS_KEY=lmsadmin
S3_SECRET_KEY=lms_dev_password
S3_REGION=us-east-1
SCHEDULE_HORIZON_WEEKS=2
DEFAULT_TIMEZONE=Europe/Moscow
