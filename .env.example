# Шаблон переменных окружения backend-приложения MY_LMS.
# Список переменных — docs/02 §7, имена сверены с src/core/config.py (Settings).
#
# КАК ПОЛЬЗОВАТЬСЯ:
#   1. Скопируйте этот файл в `.env.local`:  cp .env.example .env.local
#   2. Заполните значения для локальной разработки.
#   3. Файл `.env.local` НИКОГДА не коммитится в Git (см. .gitignore)
#      и не попадает в Docker-образ (см. .dockerignore).
#
# РЕАЛЬНЫЕ СЕКРЕТЫ:
#   Локально — только в вашем `.env.local`.
#   На серверах staging/prod — в файлах `.env` на VPS (права 600),
#   отдельные для каждого окружения (docs/10 §5). Значения ниже —
#   безопасные примеры для разработки, реальных секретов здесь нет.

# --- Окружение приложения ---
# APP_ENV: `local`, `staging` или `prod` (docs/10 §1). Влияет на строгость
# валидации настроек (например, SESSION_SECRET обязателен в prod).
APP_ENV=local

# --- База данных и кэш ---
# DATABASE_URL: строка подключения PostgreSQL (async-драйвер asyncpg).
# Локально соответствует сервису postgres из docker-compose.yml
# (тестовые пользователь/пароль, не production credentials).
DATABASE_URL=postgresql+asyncpg://lms:lms_dev_password@127.0.0.1:5432/lms

# REDIS_URL: строка подключения Redis (локальный сервис redis).
REDIS_URL=redis://127.0.0.1:6379/0

# --- Telegram-бот ---
# BOT_TOKEN: токен бота от @BotFather (до боевого запуска — тот же бот, что и в проде,
# ADR 0009; после запуска разработка переходит на отдельного dev-бота). Хранится только в .env.local.
BOT_TOKEN=

# BOT_USERNAME: username бота без @ (ссылки-приглашения https://t.me/<bot>?start=inv_…).
# Необязательно: если пусто и BOT_TOKEN задан, имя запрашивается у Telegram (getMe).
BOT_USERNAME=

# BOT_MODE: режим работы бота — `polling` локально, `webhook` на проде
# (docs/02 §2.2, docs/10 §1).
BOT_MODE=polling

# WEBHOOK_URL: базовый HTTPS-адрес вебхука бота, например
# https://<домен>/telegram/webhook (только для webhook-режима; секретный
# сегмент пути добавляется автоматически). Локально пусто.
WEBHOOK_URL=

# WEBHOOK_SECRET: секрет заголовка `X-Telegram-Bot-Api-Secret-Token` для
# защиты эндпоинта вебхука. Реальное значение — только в .env.local / на сервере.
WEBHOOK_SECRET=

# OWNER_TELEGRAM_ID: числовой Telegram ID владельца (преподавателя) — даёт
# роль owner. Узнать ID можно через @userinfobot.
OWNER_TELEGRAM_ID=

# TEACHER_CONTACT_URL: ссылка на контакт преподавателя для учеников
# (например, https://t.me/username).
TEACHER_CONTACT_URL=

# PUBLIC_BASE_URL: публичный адрес ПРИЛОЖЕНИЯ (фронтенд + API на одном домене).
# Используется для ссылок входа /web (<адрес>/login/<токен>), кнопки Mini App и
# проверки Origin на изменяющих запросах (CSRF). Значение должно совпадать с
# адресом, по которому пользователь открывает приложение в браузере:
#   - dev-сервер фронтенда (pnpm dev):  http://localhost:5173
#   - HTTPS-туннель (scripts/dev_tunnel.*): https://<адрес>.trycloudflare.com
#   - Nginx / сервер: https://<домен>
# Если указать адрес backend (порт 8000), ссылка /web откроется на API и вернёт not_found.
PUBLIC_BASE_URL=http://localhost:5173

# --- Сессии ---
# SESSION_SECRET: секрет подписи серверных сессий. Локально может быть
# пустым; в prod обязателен (проверяется в Settings). Генерация:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# SESSION_COOKIE_SECURE: флаг Secure у cookie сессии. По умолчанию true.
# Локально по HTTP (без TLS) можно поставить false; в prod только true.
SESSION_COOKIE_SECURE=true

# --- S3-совместимое хранилище файлов ---
# Локально — MinIO из docker-compose.yml (тестовые ключи). На проде —
# Timeweb Cloud S3 / Selectel, реальные ключи только на сервере (docs/10 §5).

# S3_ENDPOINT: адрес S3 API.
S3_ENDPOINT=http://127.0.0.1:9000

# S3_PUBLIC_ENDPOINT: адрес S3, который открывается с телефона (для подписанных ссылок на файлы).
# Пусто — берётся S3_ENDPOINT; локально 127.0.0.1 телефону недоступен, поэтому для проверки
# на телефоне здесь нужен публичный адрес (туннель или домен).
S3_PUBLIC_ENDPOINT=

# S3_BUCKET: имя приватного bucket для файлов ДЗ (создаётся minio-init).
S3_BUCKET=lms-files

# S3_ACCESS_KEY / S3_SECRET_KEY: доступ к хранилищу. Тестовые значения
# соответствуют локальному MinIO; боевые ключи — только в .env на сервере.
S3_ACCESS_KEY=lmsadmin
S3_SECRET_KEY=lms_dev_password

# S3_REGION: регион S3. Для локального MinIO любое согласованное значение.
S3_REGION=us-east-1

# --- Мониторинг ошибок ---
# SENTRY_DSN: DSN проекта Sentry. Пусто — интеграция отключена. Реальный
# DSN лежит в .env.local / на сервере.
SENTRY_DSN=
# VITE_SENTRY_DSN: публичный DSN Sentry для фронтенда (вшивается в сборку). Пусто — Sentry во
# фронтенде не загружается. Если задан, добавьте адрес приёма ошибок в CSP_CONNECT_EXTRA
# (например, https://o12345.ingest.sentry.io), иначе браузер заблокирует отправку.
VITE_SENTRY_DSN=
CSP_CONNECT_EXTRA=

# --- Фоновые задачи ---
# HEALTHCHECK_URL: адрес пинга Healthchecks; воркер вызывает его раз в 5 минут.
# Пусто — heartbeat выключен. Адрес содержит секретный идентификатор проверки.
HEALTHCHECK_URL=

# --- Расписание ---
# SCHEDULE_HORIZON_WEEKS: на сколько недель вперёд генерировать уроки
# из шаблонов расписания (docs/02 §7).
SCHEDULE_HORIZON_WEEKS=2

# DEFAULT_TIMEZONE: часовой пояс по умолчанию (IANA) для новых
# пользователей (используется Settings, docs/02 §7).
DEFAULT_TIMEZONE=Europe/Moscow

# --- Доступ к Telegram из РФ (docs/02 §6) ---
# TELEGRAM_API_BASE: альтернативный базовый URL Telegram API (необязательно).
# Пусто — используется официальный api.telegram.org.
TELEGRAM_API_BASE=

# TELEGRAM_PROXY_URL: SOCKS/HTTP-прокси для исходящих запросов бота
# (необязательно, актуально при блокировке Telegram в РФ).
TELEGRAM_PROXY_URL=
